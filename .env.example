# Canonical international SEO domain. Keep this in sync with public/CNAME.
NEXT_PUBLIC_SITE_URL=https://wishly.rafahim.com
# All account, editor, dashboard, payment and published-page flows remain on Wishly.bd.
NEXT_PUBLIC_APP_URL=https://wishly.bd
# Optional direct GA4 Measurement ID. For cross-domain tracking, use the same GA4 property/tag on wishly.rafahim.com and wishly.bd and configure both domains in GA4 Admin.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: show a real named author on guides (better E-E-A-T than "editorial team").
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
